# 保护一个 HTTPS 源站。复制覆盖 .env 后执行： docker compose up -d --force-recreate waf
# 不要设置 PROXY_SSL=on。该开关是上游双向证书，不是「源站走 HTTPS」。
# 源站是 HTTPS 时：BACKEND 用 https://，并打开 SNI、把 Host 写成源站域名。

WAF_HTTP_PORT=8080
CONSOLE_PORT=8090
MODSEC_RULE_ENGINE=On

BACKEND=https://www.example.com
PROXY_HOST_HEADER=www.example.com
UPSTREAM_SSL_SNI=on
UPSTREAM_SSL_NAME=www.example.com
SERVER_NAME=www.example.com

WAF_PUBLIC_URL=http://127.0.0.1:8080
DEMO_USER=admin
DEMO_PASS=admin
