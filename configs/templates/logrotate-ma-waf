/data/logs/nginx/*.json
/data/logs/nginx/*.log
/usr/local/ma-waf/var/log/*.log
{
    daily
    rotate 30
    missingok
    compress
    delaycompress
    notifempty
    create 0640 nginx nginx
    sharedscripts
    postrotate
        [ -f /usr/local/nginx/logs/nginx.pid ] && kill -USR1 $(cat /usr/local/nginx/logs/nginx.pid) 2>/dev/null || true
    endscript
}
