# 保护一个 HTTP 源站。复制覆盖 .env 后执行： docker compose up -d --force-recreate waf
# 访问方先连到本机 WAF（默认 http://服务器:8080），不要直连源站。

WAF_HTTP_PORT=8080
CONSOLE_PORT=8090
MODSEC_RULE_ENGINE=On

BACKEND=http://192.168.1.10:80
PROXY_HOST_HEADER=www.example.com
UPSTREAM_SSL_SNI=off
UPSTREAM_SSL_NAME=localhost
SERVER_NAME=www.example.com

WAF_PUBLIC_URL=http://127.0.0.1:8080
DEMO_USER=admin
DEMO_PASS=admin
