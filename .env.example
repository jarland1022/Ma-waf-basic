# 复制为 .env： copy .env.example .env
WAF_HTTP_PORT=8080
CONSOLE_PORT=8090

# On = 拦截；DetectionOnly = 只记录（上线初期建议先观察）
MODSEC_RULE_ENGINE=On

# 被保护的上游。默认指向内置 demo；接到真实业务时改成例如 http://192.168.1.10:80
# 上游若是 https://域名，请同时设置 PROXY_SSL=on（见 docker-compose.yml 注释）
BACKEND=http://demo:80
SERVER_NAME=localhost
# PROXY_SSL=off

# 控制台里「打开防护入口 / 一键试攻击」使用的外网可达地址
WAF_PUBLIC_URL=http://127.0.0.1:8080

# 社区控制台登录（请自行修改）
DEMO_USER=admin
DEMO_PASS=admin
