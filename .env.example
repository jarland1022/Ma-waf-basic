# 复制为 .env 后按需修改： copy .env.example .env
# 默认保护仓库自带的 HTTP 演示站。接到真实站点时，对照 .env.http.example 或 .env.https.example。

WAF_HTTP_PORT=8080
CONSOLE_PORT=8090

# On = 拦截；DetectionOnly = 只记录（上线初期建议先观察）
MODSEC_RULE_ENGINE=On

# 上游地址。HTTP 用 http://主机:端口 ；HTTPS 用 https://域名
BACKEND=http://demo:80

# 转发给上游的 Host。不设置时使用客户端带来的 Host。
# 真实站点请写成域名，不要带协议和端口，例如 www.example.com
# PROXY_HOST_HEADER=www.example.com

# 仅 HTTPS 上游需要 SNI。HTTP 上游保持 off
UPSTREAM_SSL_SNI=off
UPSTREAM_SSL_NAME=localhost

SERVER_NAME=localhost

# 控制台「打开防护入口」使用的地址（浏览器能打开的 WAF 入口）
WAF_PUBLIC_URL=http://127.0.0.1:8080

DEMO_USER=admin
DEMO_PASS=admin
